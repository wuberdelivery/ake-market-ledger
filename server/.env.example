# Copy to .env on the VPS. Never commit the real file.
# Fine-grained Hugging Face read token after accepting the NCAIR model terms.
HF_TOKEN=hf_replace_me

# Optional. If set, the app must send Authorization: Bearer <value>.
AKE_CLIENT_TOKEN=

MAX_AUDIO_BYTES=8388608
MAX_AUDIO_SECONDS=31
RATE_LIMIT_PER_HOUR=120
LOG_LEVEL=INFO
HF_HOME=/home/wuber/.cache/huggingface
TORCH_HOME=/home/wuber/.cache/torch
OMP_NUM_THREADS=6
